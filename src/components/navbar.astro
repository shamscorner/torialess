---
const items = [
  {
    name: "About Us",
    link: "https://www.shamscorner.com",
  },
  {
    name: "Contact",
    link: "https://www.shamscorner.com#contact",
  },
];
---

<script is:inline type="module" async>
  function openNavbar() {
    document
      .getElementById("container-mobile-menu")
      ?.classList.remove("hidden");
    document
      .getElementById("container-mobile-menu-backdrop")
      ?.classList.remove("hidden");
  }

  function closeNavbar() {
    document.getElementById("container-mobile-menu")?.classList.add("hidden");
    document
      .getElementById("container-mobile-menu-backdrop")
      ?.classList.add("hidden");
  }

  const buttonOpen = document.getElementById("button-open-navbar");
  const buttonClose = document.getElementById("button-close-navbar");

  if (buttonOpen) {
    buttonOpen.addEventListener("click", openNavbar);
  }

  if (buttonClose) {
    buttonClose.addEventListener("click", closeNavbar);
  }

  document.querySelectorAll(".navbar-item").forEach((item) => {
    item.addEventListener("click", closeNavbar);
  });
</script>

<header
  class="sticky top-0 z-40 border-b border-slate-100 bg-white"
  aria-labelledby="header-heading"
>
  <h2 id="header-heading" class="sr-only">Main navigation</h2>
  <nav
    class="mx-auto flex w-full max-w-6xl items-center justify-between gap-x-6 px-6 py-4"
    aria-label="Global"
  >
    <div class="flex items-center gap-6 lg:flex-1">
      <a
        href="/"
        class="-m-1.5 p-1.5 text-sm font-semibold uppercase tracking-[0.2em] text-slate-900"
      >
        Torialess
      </a>
    </div>
    <div class="hidden lg:flex lg:items-center lg:gap-x-8">
      {
        items.map((item) => (
          <a
            href={item.link}
            class="group relative block overflow-hidden pb-1 text-sm font-semibold text-slate-600 transition hover:text-slate-900"
          >
            {item.name}
            <span class="absolute right-0 bottom-0 left-0 block -translate-x-full border-b-2 border-slate-900 transition-transform delay-100 duration-300 group-hover:translate-x-0" />
          </a>
        ))
      }
    </div>
    <div class="flex items-center gap-5 lg:hidden">
      <button
        id="button-open-navbar"
        type="button"
        class="-m-2.5 inline-flex items-center justify-center rounded-md p-2.5 text-slate-500"
      >
        <span class="sr-only">Open menu</span>
        <svg
          class="h-6 w-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path>
        </svg>
      </button>
    </div>
  </nav>
  <!-- Mobile menu, show/hide based on menu open state. -->
  <div class="lg:hidden" role="dialog" aria-modal="true">
    <div
      id="container-mobile-menu-backdrop"
      class="fixed inset-0 z-10 hidden bg-slate-900/10 backdrop-blur-sm"
    >
    </div>
    <div
      id="container-mobile-menu"
      class="fixed inset-y-0 right-0 z-10 hidden w-full overflow-y-auto bg-white px-6 py-6 shadow-sm sm:max-w-sm"
    >
      <div class="flex items-center justify-between gap-x-6">
        <span
          class="text-sm font-semibold uppercase tracking-[0.2em] text-slate-900"
        >
          Torialess
        </span>
        <button
          id="button-close-navbar"
          type="button"
          class="-m-2.5 rounded-md p-2.5 text-slate-500"
        >
          <span class="sr-only">Close menu</span>
          <svg
            class="h-6 w-6"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
      <div class="mt-6 flow-root">
        <div class="-my-6 divide-y divide-slate-100">
          <div class="flex flex-col gap-y-2 py-6">
            {
              items.map((item) => (
                <a
                  href={item.link}
                  class="navbar-item -mx-3 block rounded-lg px-3 py-2 text-base font-semibold leading-7 text-slate-700 transition hover:bg-slate-50 hover:text-slate-900"
                >
                  {item.name}
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</header>
